# ─────────────────────────────────────────────────────────────────────────────
# WorkPlan / FlowLive — Environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
FRONTEND_PORT=80
BACKEND_PORT=5001

# ── Frontend (baked in at BUILD time — rebuild image after changing) ──────────
# Local:
VITE_API_URL=http://localhost:5001
# Remote server / production:
# VITE_API_URL=http://192.168.1.100:5001
# VITE_API_URL=https://api.yourdomain.com

# ── Backend runtime ───────────────────────────────────────────────────────────
# REQUIRED — use a long random string in production
JWT_SECRET=change_me_in_production

# URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost

# ── MongoDB Atlas (REQUIRED) ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
